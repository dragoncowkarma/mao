{
  "name": "mao",
  "version": "0.1.0",
  "description": "Electron-based Dev-Toolkit for AI-driven GitHub workflows",
  "main": "dist-electron/main.js",
  "private": true,
  "author": "mgkwon",
  "bin": {
    "mao": "dist-cli/index.cjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder",
    "build:dir": "vite build && electron-builder --dir",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx cli/index.ts",
    "build:cli": "esbuild cli/index.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist-cli/index.cjs && chmod +x dist-cli/index.cjs"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "electron-store": "^10.0.0",
    "octokit": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.12",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.mao.app",
    "productName": "MAO",
    "files": [
      "dist",
      "dist-electron"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  }
}
